# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local demo data
DATA_BACKEND=sqlite
SQLITE_DATABASE_PATH=data/talentsift-open.sqlite

# Upload limits used by the mock workflow
MAX_CV_UPLOAD_MB=10
MAX_CVS_PER_ANALYSIS=50

# The public portfolio demo uses mock extraction only.
LLM_PROVIDER=mock
LLM_MODEL=mock-local

# Privacy and retention
PRIVACY_DELETE_SOURCE_DOCUMENTS=true
ANALYSIS_RETENTION_HOURS=168

# Exports
CSV_EXPORT_ENABLED=true
